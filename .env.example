# Miscord environment template
# TEST VALUES ONLY. Replace every value containing test/replace-me before production use.
# Copy with: cp .env.example .env

# Frontend
NEXT_PUBLIC_API_URL=https://miscord.ru
NEXT_PUBLIC_WS_URL=wss://miscord.ru

# Backend
ENVIRONMENT=production
SERVER_HOST=https://miscord.ru
SECRET_KEY=test-only-secret-key-replace-with-64-random-characters-000000000000
CORS_ORIGINS=["https://miscord.ru","https://www.miscord.ru","http://localhost:3000"]

# PostgreSQL
POSTGRES_DB=miscord
POSTGRES_USER=miscord_user
POSTGRES_PASSWORD=test-db-password-replace-me
DATABASE_URL=postgresql://miscord_user:test-db-password-replace-me@postgres:5432/miscord

# Redis
REDIS_URL=redis://redis:6379

# Incoming webhooks and attachment security
WEBHOOKS_ENABLED=true
WEBHOOK_FILES_ENABLED=true
# Must be a URL-safe base64 encoding of exactly 32 bytes.
WEBHOOK_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ATTACHMENT_SIGNING_KEY=test-only-attachment-signing-key-replace-me-0000000000000000
ATTACHMENT_STORAGE_DIR=/app/data/attachments
ATTACHMENT_QUARANTINE_DIR=/app/data/quarantine
ATTACHMENT_X_ACCEL_ENABLED=false

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Timeweb S3
S3_ENABLED=true
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=0eef806a-8dfc-4e04-8221-b1029853cfcf
S3_ACCESS_KEY_ID=test-s3-access-key-replace-me
S3_SECRET_ACCESS_KEY=test-s3-secret-access-key-replace-me
S3_KEY_PREFIX=miscord
S3_CDN_BASE_URL=https://78ormlxxqc.cdn.twcstorage.ru
S3_CDN_SECURE_TOKEN=test-cdn-secure-token-replace-me-000000000000000000000000
S3_DELIVERY_URL_TTL_SECONDS=86400

# TURN / WebRTC
TURN_EXTERNAL_IP=178.49.247.209
TURN_USERNAME=miscord
TURN_PASSWORD=test-turn-password-replace-me
TURN_REALM=miscord.ru
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]},{"urls":["turn:miscord.ru:3478?transport=udp","turn:miscord.ru:3478?transport=tcp"],"username":"miscord","credential":"test-turn-password-replace-me"}]
