# Miscord env example (без секретов)
# 1) cp .env.example .env
# 2) замените плейсхолдеры своими значениями
# 3) docker compose -f docker-compose.server.yml up -d

# === Frontend ===
NEXT_PUBLIC_API_URL=https://your-domain.com
NEXT_PUBLIC_WS_URL=wss://your-domain.com

# === Backend ===
ENVIRONMENT=production
SERVER_HOST=https://your-domain.com
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["https://your-domain.com", "https://www.your-domain.com", "http://localhost:3000"]

# === Database ===
POSTGRES_DB=miscord
POSTGRES_USER=miscord_user
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql://miscord_user:change-me-db-password@postgres:5432/miscord

# === Redis ===
REDIS_URL=redis://redis:6379

# === TURN / WebRTC ===
TURN_EXTERNAL_IP=YOUR.PUBLIC.IP.HERE
TURN_USERNAME=miscord
TURN_PASSWORD=change-me-turn-password
TURN_REALM=your-domain.com
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]},{"urls":["turn:your-domain.com:3478?transport=udp","turn:your-domain.com:3478?transport=tcp"],"username":"miscord","credential":"change-me-turn-password"}]
